{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["*.js", "*.ts", "*.jsx", "*.tsx", "*.json", "*.html"],
    "ignore": ["node_modules", "dist", "build", "coverage", "tsconfig.*"]
  },
  "formatter": {
    "attributePosition": "auto",
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "assists": {
    "actions": {
      "source": {
        "sortJsxProps": "on"
      }
    }
  }
}
