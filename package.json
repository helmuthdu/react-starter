{
  "name": "react-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "npm run lint:script && npm run lint:style``",
    "lint:script": "biome check  --apply-unsafe src",
    "lint:style": "stylelint --fix src/**/*.{css,scss,vue}",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "coveralls": "vitest --run --coverage | coveralls"
  },
  "dependencies": {
    "@sentry/react": "~8.14.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "history": "^5.3.0",
    "isomorphic-unfetch": "^4.0.2",
    "number-format.js": "^2.0.9",
    "radash": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.52.1",
    "react-intl": "^6.6.8",
    "react-router": "^6.24.1",
    "react-router-dom": "^6.24.1",
    "react-window": "^1.8.10",
    "recoil": "^0.7.7",
    "rxjs": "^7.8.1",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/testing-library__jest-dom": "6.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "coveralls": "^3.1.1",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.1.0",
    "lefthook": "^1.6.18",
    "postcss": "^8.4.39",
    "postcss-html": "^1.7.0",
    "sass": "^1.77.6",
    "stylelint": "^16.6.1",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-node": "^1.6.0",
    "vitest": "^1.6.0"
  }
}
