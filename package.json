{
  "name": "react-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "concurrently -c \"auto\" \"npm:lint:js\" \"npm:lint:css\"",
    "lint:js": "biome check src",
    "lint:css": "stylelint src/**/*.{css,scss}",
    "fix": "concurrently -c \"auto\" \"npm:fix:js\" \"npm:fix:css\"",
    "fix:js": "biome check --write --unsafe src",
    "fix:css": "stylelint --fix \"strict\" src/**/*.{css,scss}",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "coveralls": "vitest --run --coverage | coveralls"
  },
  "dependencies": {
    "@nanostores/persistent": "^0.10.2",
    "@nanostores/react": "^0.8.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "history": "^5.3.0",
    "isomorphic-unfetch": "^4.0.2",
    "nanostores": "^0.11.3",
    "number-format.js": "^2.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.54.2",
    "react-intl": "^7.1.6",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.5",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "coveralls": "^3.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "lefthook": "^1.10.10",
    "sass": "^1.85.0",
    "stylelint": "^16.14.1",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
