{
  "name": "react-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "coveralls": "vitest --run --coverage | coveralls",
    "deploy": "gh-pages -d build",
    "dev": "vite",
    "fix": "concurrently -c \"auto\" \"npm:fix:js\" \"npm:fix:css\"",
    "fix:css": "stylelint --fix \"lax\" src/**/*.{css,scss}",
    "fix:js": "biome check --write --unsafe src",
    "lint": "concurrently -c \"auto\" \"npm:lint:js\" \"npm:lint:css\"",
    "lint:css": "stylelint src/**/*.{css,scss}",
    "lint:js": "biome check src",
    "predeploy": "npm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@nanostores/persistent": "^1.1.0",
    "@nanostores/react": "^1.0.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "history": "^5.3.0",
    "isomorphic-unfetch": "^4.0.2",
    "nanostores": "^1.0.1",
    "number-format.js": "^2.0.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-intl": "^7.1.11",
    "react-router": "^7.7.1",
    "react-router-dom": "^7.7.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "coveralls": "^3.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "lefthook": "^1.12.2",
    "lodash": "^4.17.21",
    "mitata": "^1.0.34",
    "sass": "^1.89.2",
    "stylelint": "^16.23.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "tinybench": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
